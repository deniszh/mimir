{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for Mimir metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Loki datasource for query-frontend logs",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "id": null,
  "uid": null,
  "title": "Mimir / Tenant Query Impact",
  "description": "Per-tenant query load, resource consumption, and scheduler health. Uses query-frontend Prometheus metrics and Loki query stats logs.",
  "tags": ["mimir", "tenant", "query", "observability"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "1m",
  "schemaVersion": 38,
  "version": 1,
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "loki_datasource",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Loki",
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(cortex_query_frontend_queries_total, cluster)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "label": "Cluster"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(cortex_query_frontend_queries_total{cluster=\"$cluster\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "label": "Namespace"
      },
      {
        "name": "tenant",
        "type": "textbox",
        "current": { "value": ".*", "text": ".*", "selected": false },
        "hide": 0,
        "label": "Tenant (regex)",
        "options": [{ "value": ".*", "text": ".*", "selected": false }]
      },
      {
        "name": "topk",
        "type": "custom",
        "query": "5,10,20,50",
        "current": { "value": "10", "text": "10", "selected": true },
        "hide": 0,
        "label": "Top N",
        "multi": false,
        "includeAll": false,
        "options": [
          { "value": "5", "text": "5", "selected": false },
          { "value": "10", "text": "10", "selected": true },
          { "value": "20", "text": "20", "selected": false },
          { "value": "50", "text": "50", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Top Tenants by Query Rate",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "QPS by Tenant (top $topk)",
      "description": "Queries per second by tenant, showing the top N busiest tenants.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "qps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topk($topk, sum by (user) (rate(cortex_query_frontend_queries_total{cluster=\"$cluster\", namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{user}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "QPS by Operation (tenant: $tenant)",
      "description": "Queries per second for the selected tenant, broken down by operation type (query_range, query, remote_read, etc.).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "qps",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (op) (rate(cortex_query_frontend_queries_total{cluster=\"$cluster\", namespace=\"$namespace\", user=~\"$tenant\"}[$__rate_interval]))",
          "legendFormat": "{{op}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Ingester & Store-Gateway Impact",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 10,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Wall Time / sec by Tenant (top $topk)",
      "description": "Total wall clock time consumed per second, per tenant. Proxy for CPU cost on ingesters and store-gateways.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 11,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topk($topk, sum by (user) (rate(cortex_query_seconds_total{cluster=\"$cluster\", namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{user}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fetched Series / sec by Tenant (top $topk)",
      "description": "Series fetched per second per tenant. Proxy for ingester and store-gateway memory pressure.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 12,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topk($topk, sum by (user) (rate(cortex_query_fetched_series_total{cluster=\"$cluster\", namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{user}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fetched Chunk Bytes / sec by Tenant (top $topk)",
      "description": "Chunk bytes fetched per second per tenant. Proxy for store-gateway I/O and network usage.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 13,
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topk($topk, sum by (user) (rate(cortex_query_fetched_chunk_bytes_total{cluster=\"$cluster\", namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{user}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fetched Index Bytes / sec by Tenant (top $topk)",
      "description": "TSDB index bytes fetched per second per tenant from store-gateways.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 14,
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topk($topk, sum by (user) (rate(cortex_query_fetched_index_bytes_total{cluster=\"$cluster\", namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{user}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Samples Processed / sec by Tenant (top $topk)",
      "description": "Samples processed per second per tenant. Proxy for query engine CPU usage.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "id": 15,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "topk($topk, sum by (user) (rate(cortex_query_samples_processed_total{cluster=\"$cluster\", namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{user}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Scheduler Queue Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 20,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Queue Depth (tenant: $tenant)",
      "description": "Number of queries currently in the scheduler queue for the selected tenant.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 35 },
      "id": 21,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "cortex_query_scheduler_queue_length{cluster=\"$cluster\", namespace=\"$namespace\", user=~\"$tenant\"}",
          "legendFormat": "{{user}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Discarded Requests / sec (tenant: $tenant)",
      "description": "Rate of scheduler-rejected (HTTP 429) queries per tenant. Non-zero means the tenant is being throttled.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 35 },
      "id": 22,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(cortex_query_scheduler_discarded_requests_total{cluster=\"$cluster\", namespace=\"$namespace\", user=~\"$tenant\"}[$__rate_interval])",
          "legendFormat": "{{user}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue Wait Time p99 (tenant: $tenant)",
      "description": "99th percentile time queries spend in the scheduler queue before being picked up by a querier.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 35 },
      "id": 23,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le, user) (rate(cortex_query_scheduler_queue_duration_seconds_bucket{cluster=\"$cluster\", namespace=\"$namespace\", user=~\"$tenant\"}[$__rate_interval])))",
          "legendFormat": "{{user}} p99"
        }
      ]
    },
    {
      "type": "row",
      "title": "Per-Query Detail (Loki)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 30,
      "panels": [
        {
          "type": "table",
          "title": "Heavy Queries (fetched_series_count > 10000)",
          "description": "Individual queries that fetched more than 10,000 series, from Loki query stats logs. Useful for identifying specific problematic queries.",
          "datasource": { "type": "loki", "uid": "${loki_datasource}" },
          "gridPos": { "h": 10, "w": 24, "x": 0, "y": 44 },
          "id": 31,
          "options": {
            "showHeader": true,
            "sortBy": [{ "displayName": "fetched_series_count", "desc": true }]
          },
          "fieldConfig": { "defaults": {}, "overrides": [] },
          "targets": [
            {
              "datasource": { "type": "loki", "uid": "${loki_datasource}" },
              "expr": "{cluster=\"$cluster\", namespace=\"$namespace\", container=~\"query-frontend.*\"} |= \"query stats\" | logfmt | user=~\"$tenant\" | fetched_series_count > 10000 | line_format \"user={{.user}} series={{.fetched_series_count}} chunks={{.fetched_chunks_count}} chunk_bytes={{.fetched_chunk_bytes}} wall={{.query_wall_time_seconds}}s status={{.status}} query={{.param_query}}\"",
              "refId": "A"
            }
          ],
          "transformations": []
        },
        {
          "type": "timeseries",
          "title": "Top Tenants by Fetched Series (p99 from Loki)",
          "description": "99th percentile of fetched_series_count per tenant, computed from Loki query stats logs.",
          "datasource": { "type": "loki", "uid": "${loki_datasource}" },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
          "id": 32,
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": { "drawStyle": "line", "fillOpacity": 10 }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
            "tooltip": { "mode": "multi", "sort": "desc" }
          },
          "targets": [
            {
              "datasource": { "type": "loki", "uid": "${loki_datasource}" },
              "expr": "topk(10, quantile_over_time(0.99, {cluster=\"$cluster\", namespace=\"$namespace\", container=~\"query-frontend.*\"} |= \"query stats\" | logfmt | unwrap fetched_series_count [$__auto]) by (user))",
              "legendFormat": "{{user}}"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Top Tenants by Wall Time (p99 from Loki)",
          "description": "99th percentile of query_wall_time_seconds per tenant, computed from Loki query stats logs.",
          "datasource": { "type": "loki", "uid": "${loki_datasource}" },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
          "id": 33,
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": { "drawStyle": "line", "fillOpacity": 10 }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
            "tooltip": { "mode": "multi", "sort": "desc" }
          },
          "targets": [
            {
              "datasource": { "type": "loki", "uid": "${loki_datasource}" },
              "expr": "topk(10, quantile_over_time(0.99, {cluster=\"$cluster\", namespace=\"$namespace\", container=~\"query-frontend.*\"} |= \"query stats\" | logfmt | unwrap query_wall_time_seconds [$__auto]) by (user))",
              "legendFormat": "{{user}}"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Top Tenants by Chunk Bytes (sum from Loki)",
          "description": "Total chunk bytes fetched per tenant over time, from Loki query stats logs. Proxy for store-gateway I/O impact.",
          "datasource": { "type": "loki", "uid": "${loki_datasource}" },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 62 },
          "id": 34,
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "custom": { "drawStyle": "line", "fillOpacity": 10 }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
            "tooltip": { "mode": "multi", "sort": "desc" }
          },
          "targets": [
            {
              "datasource": { "type": "loki", "uid": "${loki_datasource}" },
              "expr": "topk(10, sum by (user) (sum_over_time({cluster=\"$cluster\", namespace=\"$namespace\", container=~\"query-frontend.*\"} |= \"query stats\" | logfmt | unwrap fetched_chunk_bytes [$__auto])))",
              "legendFormat": "{{user}}"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Failed/Slow Queries per Tenant (from Loki)",
          "description": "Count of non-success queries per tenant and status (failed, canceled, timeout).",
          "datasource": { "type": "loki", "uid": "${loki_datasource}" },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 62 },
          "id": 35,
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": { "drawStyle": "bars", "fillOpacity": 50, "stacking": { "mode": "normal" } }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
            "tooltip": { "mode": "multi", "sort": "desc" }
          },
          "targets": [
            {
              "datasource": { "type": "loki", "uid": "${loki_datasource}" },
              "expr": "sum by (user, status) (count_over_time({cluster=\"$cluster\", namespace=\"$namespace\", container=~\"query-frontend.*\"} |= \"query stats\" | logfmt | user=~\"$tenant\" | status!=\"success\" [$__auto]))",
              "legendFormat": "{{user}} ({{status}})"
            }
          ]
        }
      ]
    }
  ]
}
